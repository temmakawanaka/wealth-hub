{
  "name": "wealth-hub",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "preinstall": "node scripts/verify-environment.mjs",
    "predev": "npm run verify:env",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run src",
    "test:tooling": "node --test scripts/tooling.test.mjs",
    "verify:env": "node scripts/verify-environment.mjs",
    "verify:repo": "node scripts/verify-repo.mjs",
    "audit:deps": "npm audit --audit-level=moderate",
    "check": "npm run verify:env && npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:tooling && npm run build && npm run verify:repo && npm run audit:deps"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
  }
}
